# 서버의 /etc/bot_dash.env 로 복사한 뒤 값을 바꾸세요.
# 이 파일은 웹 폴더에 올리지 마세요. 컨테이너라면 같은 이름의 환경 변수로 넣어도 됩니다.
BOTDASH_USER=replace-me
BOTDASH_PASSWORD=replace-with-a-long-random-password

# 블로거 오늘 계산 로그. 1 이면 data/blogger_count.log 에 남긴다. 0 이거나 줄이 없으면 꺼진다.
BOTDASH_COUNT_LOG=0

# Blogger 페이지뷰. 이름은 캐릭터 파일명과 같게 붙인다. na_nuri 는 characters/na_nuri.md 이다.
# 블로그 주소는 그 파일에 있는 것을 쓴다. 같은 계정의 블로그는 토큰 한 세트로 충분하다.
# BLOGGER_CLIENT_ID_na_nuri=
# BLOGGER_CLIENT_SECRET_na_nuri=
# BLOGGER_REFRESH_TOKEN_na_nuri=
